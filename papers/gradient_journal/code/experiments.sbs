#!/bin/bash
#SBATCH --time=3-00:00:00
#SBATCH -o /mnt/beegfs/rcabanas/dev/counterfactual-zeros/logs/%x.%j.out


for file in ../../models/synthetic/s23/*ts$nparents*.uai ; do
    #srun -n 1 -N 1 -c 1 -t 2000  /mnt/beegfs/rcabanas/singularity/singpy.sif python -u experiments.py -m DCCC -n 100 -o ../results/synthetic/s23/ $file 2> /dev/null &
    #srun -n 1 -N 1 -c 1 -t 2000 /mnt/beegfs/rcabanas/singularity/singpy.sif python -u experiments.py -m EMCC-50 -n 100 -o ../results/synthetic/s23/ $file 2> /dev/null &
    #srun -n 1 -N 1 -c 1 -t 2000 /mnt/beegfs/rcabanas/singularity/singpy.sif python -u experiments.py -m EMCC-100 -n 100 -o ../results/synthetic/s23/ $file 2> /dev/null &
    #srun -n 1 -N 1 -c 1 -t 2000 /mnt/beegfs/rcabanas/singularity/singpy.sif python -u experiments.py -m EMCC-150 -n 100 -o ../results/synthetic/s23/ $file 2> /dev/null &
    srun -n 1 -N 1 -c 1 -t 2000 /mnt/beegfs/rcabanas/singularity/singpy.sif python -u experiments.py -m GSCC-0 -n 500 -o ../results/synthetic/s23/ $file 2> /dev/null &
