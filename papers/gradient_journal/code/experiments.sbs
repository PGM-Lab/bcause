#!/bin/bash
#SBATCH --time=3-00:00:00
#SBATCH -o /mnt/beegfs/rcabanas/dev/bcause/papers/gradient_journal/logs/%x.%j.out


for file in ../models/synthetic/s123/*.*.uai ; do
